# Your own statements and processed originals never belong in a public remote.
inbox/*
!inbox/README.txt
!inbox/.gitkeep
archive/*
!archive/.gitkeep

# The findata/ shipped here is synthetic. When setup writes your own, it takes this line out of
# the comment (with dashboards/ and decisions/) and installs a pre-commit guard (setup/scripts/guard.py):
# findata/

.DS_Store
__pycache__/
.claude/settings.local.json

# the owner's private deny list, if a workspace is ever opened here
.private/
findata/register/setup-answers.json

# update.py --write keeps a copy of findata/ here so a failed or unwanted run can be taken back
.undo/
findata.restoring/
findata.replaced/
